---
import Layout from '../layouts/Layout.astro';
import { getPublishedBerita, getTiktokVideos, getProfilMasjid } from '../lib/db';

const beritaTerbaru = await getPublishedBerita(6);
const tiktoks = await getTiktokVideos();
const profil = await getProfilMasjid();
---

<Layout title="Beranda - Portal Masjid Al-Ma'mur">
	<!-- Hero Section -->
	<div class="relative rounded-3xl overflow-hidden mb-16 shadow-2xl group">
		<!-- Background Image -->
		<div class="absolute inset-0">
			<img src={profil?.default_image_url || "/images/hero-bg.png"} alt="Masjid Al-Ma'mur" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
			<div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-emerald-900/80 to-transparent"></div>
		</div>
		
		<!-- Hero Content -->
		<div class="relative p-10 md:p-16 lg:p-24 flex flex-col items-start justify-center min-h-[500px]">
			<span class="px-4 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 font-semibold text-sm mb-6 border border-emerald-500/30 backdrop-blur-sm">
				Selamat Datang
			</span>
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight max-w-2xl">
				Cahaya Islam di Tengah <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">Kehidupan Modern</span>
			</h1>
			<p class="text-lg md:text-xl text-slate-200 mb-10 max-w-xl leading-relaxed">
				Portal resmi Masjid Al-Ma'mur. Pusat kegiatan ibadah, kajian keislaman, dan pemberdayaan umat untuk meraih ridha Allah SWT.
			</p>
			<div class="flex flex-wrap gap-4">
				<a href="/kategori/kajian" class="px-8 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-full transition-all duration-300 shadow-lg shadow-emerald-600/30 flex items-center gap-2">
					Lihat Jadwal Kajian
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
					</svg>
				</a>
				<a href="#berita" class="px-8 py-3.5 bg-white/10 hover:bg-white/20 text-white font-bold rounded-full backdrop-blur-md transition-all duration-300 border border-white/20">
					Berita Terbaru
				</a>
			</div>
		</div>
	</div>

	<div class="flex flex-col lg:flex-row gap-10">
		<div class="lg:w-2/3" id="berita">
			<div class="flex items-center justify-between mb-8">
				<div>
					<h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Berita & Informasi</h2>
					<p class="text-slate-500 mt-1">Kabar terbaru seputar kegiatan Masjid</p>
				</div>
				<a href="#" class="hidden sm:flex items-center gap-1 text-emerald-600 font-semibold hover:text-emerald-700 transition-colors group">
					Lihat Semua
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
					</svg>
				</a>
			</div>
			
			{beritaTerbaru.length === 0 ? (
				<div class="bg-white rounded-2xl p-12 text-center shadow-sm border border-slate-100">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-slate-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H14" />
					</svg>
					<p class="text-slate-500 text-lg">Belum ada berita yang diterbitkan saat ini.</p>
				</div>
			) : (
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
					{beritaTerbaru.map((item) => (
						<article class="bg-white rounded-2xl shadow-sm hover:shadow-xl border border-slate-100 overflow-hidden hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full">
							<div class="h-56 w-full overflow-hidden relative">
								<img src={item.gambar_utama || "/images/placeholder.png"} alt={item.judul} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
								<div class="absolute top-4 left-4">
									<span class="bg-white/90 backdrop-blur-sm text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider shadow-sm">
										{item.nama_kategori}
									</span>
								</div>
							</div>
							<div class="p-6 flex flex-col flex-grow">
								<h3 class="text-xl font-bold mb-3 text-slate-900 line-clamp-2 leading-snug group-hover:text-emerald-600 transition-colors">
									<a href={`/berita/${item.slug}`}>
										{item.judul}
										<span class="absolute inset-0" aria-hidden="true"></span>
									</a>
								</h3>
								<p class="text-slate-600 text-sm mb-6 line-clamp-3 leading-relaxed flex-grow">{item.ringkasan}</p>
								<div class="flex justify-between items-center text-sm font-medium text-slate-500 pt-4 border-t border-slate-100 mt-auto">
									<div class="flex items-center gap-2">
										<div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">
											{item.penulis.charAt(0).toUpperCase()}
										</div>
										<span>{item.penulis}</span>
									</div>
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
										</svg>
										{item.views}
									</span>
								</div>
							</div>
						</article>
					))}
				</div>
			)}
		</div>
		
		<aside class="lg:w-1/3 space-y-8">
			<!-- Waktu Sholat Widget -->
			<div class="bg-gradient-to-br from-emerald-600 to-teal-700 rounded-3xl shadow-xl overflow-hidden text-white relative">
				<div class="absolute top-0 right-0 -mr-8 -mt-8 w-40 h-40 rounded-full bg-white/10 blur-2xl"></div>
				<div class="absolute bottom-0 left-0 -ml-8 -mb-8 w-40 h-40 rounded-full bg-teal-900/40 blur-2xl"></div>
				
				<div class="relative p-8">
					<div class="flex justify-between items-center mb-8">
						<div>
							<h3 class="text-xl font-bold">Jadwal Sholat</h3>
							<p class="text-emerald-100 text-sm mt-1">Bekasi Barat</p>
						</div>
						<div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-md">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
						</div>
					</div>
					
					<div class="space-y-4">
						<div class="flex justify-between items-center p-3 rounded-xl hover:bg-white/10 transition-colors">
							<div class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-emerald-300"></span>
								<span class="font-medium">Subuh</span>
							</div>
							<span class="font-bold tracking-wider">04:30</span>
						</div>
						<div class="flex justify-between items-center p-3 rounded-xl hover:bg-white/10 transition-colors">
							<div class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-emerald-300"></span>
								<span class="font-medium">Dzuhur</span>
							</div>
							<span class="font-bold tracking-wider">11:55</span>
						</div>
						<!-- Current Prayer Time Highlight -->
						<div class="flex justify-between items-center p-3 rounded-xl bg-white text-emerald-800 shadow-md transform scale-105 my-2">
							<div class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
								<span class="font-bold">Ashar</span>
							</div>
							<span class="font-extrabold tracking-wider">15:15</span>
						</div>
						<div class="flex justify-between items-center p-3 rounded-xl hover:bg-white/10 transition-colors">
							<div class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-emerald-300"></span>
								<span class="font-medium">Maghrib</span>
							</div>
							<span class="font-bold tracking-wider">17:58</span>
						</div>
						<div class="flex justify-between items-center p-3 rounded-xl hover:bg-white/10 transition-colors">
							<div class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-emerald-300"></span>
								<span class="font-medium">Isya</span>
							</div>
							<span class="font-bold tracking-wider">19:10</span>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Kategori Widget -->
			<div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8">
				<h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
					</svg>
					Jelajahi Kategori
				</h3>
				<ul class="space-y-3">
					<li>
						<a href="/kategori/kajian" class="group flex items-center justify-between p-4 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all border border-transparent hover:border-emerald-100">
							<span class="font-medium text-slate-700 group-hover:text-emerald-700">Kajian & Ilmu</span>
							<div class="w-8 h-8 rounded-full bg-white flex items-center justify-center shadow-sm text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							</div>
						</a>
					</li>
					<li>
						<a href="/kategori/kegiatan" class="group flex items-center justify-between p-4 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all border border-transparent hover:border-emerald-100">
							<span class="font-medium text-slate-700 group-hover:text-emerald-700">Kegiatan Masjid</span>
							<div class="w-8 h-8 rounded-full bg-white flex items-center justify-center shadow-sm text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							</div>
						</a>
					</li>
					<li>
						<a href="/kategori/pengumuman" class="group flex items-center justify-between p-4 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all border border-transparent hover:border-emerald-100">
							<span class="font-medium text-slate-700 group-hover:text-emerald-700">Pengumuman</span>
							<div class="w-8 h-8 rounded-full bg-white flex items-center justify-center shadow-sm text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
								</svg>
							</div>
						</a>
					</li>
				</ul>
			</div>
		</aside>
	</div>

	<!-- TikTok Section -->
	<div class="mt-24 mb-8">
		<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 gap-4">
			<div class="flex items-center gap-4">
				<div class="w-14 h-14 bg-black text-white rounded-2xl flex items-center justify-center shadow-lg shadow-black/20">
					<svg fill="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
				</div>
				<div>
					<h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Dakwah di TikTok</h2>
					<p class="text-slate-500 mt-1">Ikuti konten inspiratif kami setiap hari</p>
				</div>
			</div>
			<a href="#" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-full transition-all shadow-md hover:shadow-lg">
				Follow Kami
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
				</svg>
			</a>
		</div>

		<!-- Horizontal Scroll / Slider -->
		<div class="flex overflow-x-auto pb-10 -mx-4 px-4 lg:mx-0 lg:px-0 gap-6 snap-x snap-mandatory hide-scrollbar">
			{tiktoks.length > 0 ? tiktoks.map((item) => (
				<a href={item.url_video} target="_blank" rel="noopener noreferrer" class="snap-center shrink-0 w-64 h-[420px] relative rounded-[2rem] overflow-hidden group shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 border border-slate-100">
					<img src={item.thumbnail || "/images/placeholder.png"} alt={item.judul} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
					<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
					
					<!-- Play Button Overlay -->
					<div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
						<div class="w-16 h-16 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center border border-white/30 text-white shadow-xl transform group-hover:scale-110 transition-transform">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 ml-1" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
							</svg>
						</div>
					</div>
					
					<!-- Content -->
					<div class="absolute bottom-6 left-5 right-5 text-white">
						<div class="flex items-center gap-2 mb-3">
							<div class="w-8 h-8 rounded-full bg-emerald-500 flex items-center justify-center border-2 border-white text-xs font-bold shadow-md">M</div>
							<span class="text-sm font-semibold drop-shadow-md">@masjidalmamur</span>
						</div>
						<p class="text-sm line-clamp-2 text-slate-200 drop-shadow-md mb-3">{item.judul}</p>
						
						<div class="flex items-center gap-4 text-xs font-medium text-slate-300">
							<span class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z" /><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg> {item.views || 0}</span>
							<span class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-pink-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" /></svg> {item.likes || 0}</span>
						</div>
					</div>
				</a>
			)) : (
				<div class="w-full text-center py-10 bg-slate-50 rounded-2xl border border-slate-100">
					<p class="text-slate-500">Video TikTok belum tersedia.</p>
				</div>
			)}
		</div>
	</div>

</Layout>

<style>
	.hide-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.hide-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>

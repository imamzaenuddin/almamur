---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { pool } from '../../../lib/db';

const [galeri] = await pool.query("SELECT * FROM galeri ORDER BY created_at DESC");
---
<AdminLayout title="Manajemen Galeri">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Manajemen Galeri Foto</h1>
            <p class="text-slate-500 text-sm mt-1">Kelola foto-foto kegiatan masjid.</p>
        </div>
        <button onclick="bukaModalTambah()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg font-medium shadow-md transition flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" /></svg>
            Tambah Foto
        </button>
    </div>

    {galeri.length === 0 ? (
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-12 text-center">
            <p class="text-slate-500">Belum ada foto galeri.</p>
        </div>
    ) : (
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {galeri.map((item) => (
                <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden group">
                    <div class="h-48 relative overflow-hidden bg-slate-100">
                        <img src={item.gambar_url} alt={item.judul} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <div class="p-4">
                        <h3 class="font-bold text-slate-800 line-clamp-1">{item.judul}</h3>
                        <p class="text-xs text-slate-500 mt-1 line-clamp-2">{item.deskripsi}</p>
                        <div class="flex justify-end gap-3 mt-4 pt-3 border-t border-slate-100">
                            <button onclick={`editGaleri(${JSON.stringify(item)})`} class="text-xs text-amber-500 hover:text-amber-700 font-medium">Edit</button>
                            <button onclick={`hapusGaleri(${item.id})`} class="text-xs text-red-500 hover:text-red-700 font-medium">Hapus</button>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    )}

    <!-- Modal Tambah -->
    <div id="modalTambah" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center z-50 p-4">
        <div class="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-100">
            <div class="flex justify-between items-center mb-5">
                <h2 id="modalTitle" class="text-xl font-bold text-slate-800">Tambah Foto Galeri</h2>
                <button onclick="document.getElementById('modalTambah').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-2xl leading-none">&times;</button>
            </div>
            <form id="formTambahGaleri" class="space-y-4">
                <input type="hidden" name="id" id="formId">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Judul Foto</label>
                    <input type="text" name="judul" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">URL Gambar</label>
                    <div class="flex gap-2">
                        <input type="text" id="gambar_url" name="gambar_url" required class="flex-grow px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none" placeholder="https://...">
                        <label class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-lg cursor-pointer flex items-center transition whitespace-nowrap">
                            Upload
                            <input type="file" class="hidden" accept="image/*" onchange="uploadImage(this, 'gambar_url')">
                        </label>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Deskripsi Singkat</label>
                    <textarea name="deskripsi" rows="3" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none"></textarea>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-lg transition mt-6 shadow-md">Simpan Foto</button>
            </form>
        </div>
    </div>

    <script is:inline>
        function bukaModalTambah() {
            document.getElementById('modalTitle').innerText = 'Tambah Foto Galeri';
            document.getElementById('formId').value = '';
            document.getElementById('formTambahGaleri').reset();
            document.getElementById('modalTambah').classList.remove('hidden');
        }

        function editGaleri(item) {
            document.getElementById('modalTitle').innerText = 'Edit Foto Galeri';
            document.getElementById('formId').value = item.id;
            document.getElementById('formTambahGaleri').elements['judul'].value = item.judul;
            document.getElementById('formTambahGaleri').elements['gambar_url'].value = item.gambar_url;
            document.getElementById('formTambahGaleri').elements['deskripsi'].value = item.deskripsi || '';
            document.getElementById('modalTambah').classList.remove('hidden');
        }

        document.getElementById('formTambahGaleri').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            try {
                const res = await fetch('/api/galeri', { method: 'POST', body: formData });
                if(res.ok) window.location.reload();
                else alert('Gagal menambah foto');
            } catch(err) {
                alert('Terjadi kesalahan koneksi.');
            }
        });

        async function hapusGaleri(id) {
            if(confirm('Hapus foto ini?')) {
                try {
                    const res = await fetch(`/api/galeri?id=${id}`, { method: 'DELETE' });
                    if(res.ok) window.location.reload();
                } catch(err) {
                    alert('Terjadi kesalahan koneksi.');
                }
            }
        }
    </script>
</AdminLayout>

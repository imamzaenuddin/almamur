---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { pool } from '../../../../lib/db';

const { id } = Astro.params;

// Ambil data berita
const [[berita]] = await pool.query('SELECT * FROM berita WHERE id = ?', [id]);
if (!berita) return Astro.redirect('/admin/berita');

// Ambil daftar kategori untuk dropdown
const [kategori] = await pool.query('SELECT id, nama_kategori FROM kategori ORDER BY nama_kategori');
---

<AdminLayout title="Edit Berita">
	<div class="max-w-3xl mx-auto bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
		<div class="bg-slate-900 px-6 py-5">
			<h1 class="text-xl font-bold text-white">Edit Berita / Konten</h1>
		</div>
		
		<div class="p-6">
			<form id="form-berita" class="space-y-6">
                <input type="hidden" name="id" value={berita.id}>
                <input type="hidden" name="slug" value={berita.slug}>
				<div>
					<label for="judul" class="block text-sm font-medium text-gray-700 mb-1">Judul Berita</label>
					<input type="text" id="judul" name="judul" value={berita.judul} required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500">
				</div>
				
				<div>
					<label for="gambar_utama" class="block text-sm font-medium text-gray-700 mb-1">Gambar Utama</label>
                    <div class="flex gap-2">
					    <input type="text" id="gambar_utama" name="gambar_utama" value={berita.gambar_utama || ''} class="flex-grow px-4 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500" placeholder="URL gambar atau upload...">
                        <label class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-md cursor-pointer flex items-center transition">
                            Upload
                            <input type="file" class="hidden" accept="image/*" onchange="uploadImage(this, 'gambar_utama')">
                        </label>
                    </div>
				</div>
				
				<div>
					<label for="id_kategori" class="block text-sm font-medium text-gray-700 mb-1">Kategori</label>
					<select id="id_kategori" name="id_kategori" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500">
						{kategori.map((k) => (
							<option value={k.id} selected={k.id === berita.id_kategori}>{k.nama_kategori}</option>
						))}
					</select>
				</div>
				
				<div>
					<label for="ringkasan" class="block text-sm font-medium text-gray-700 mb-1">Ringkasan Singkat</label>
					<textarea id="ringkasan" name="ringkasan" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500">{berita.ringkasan}</textarea>
				</div>
				
				<div>
					<label for="isi_konten" class="block text-sm font-medium text-gray-700 mb-1">Isi Berita Lengkap (Mendukung HTML)</label>
					<textarea id="isi_konten" name="isi_konten" rows="8" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500">{berita.isi_konten}</textarea>
				</div>
				
				<div class="pt-6 border-t border-slate-200 mt-6">
					<h2 class="text-lg font-bold text-slate-800 mb-4">Pengaturan SEO (Opsional)</h2>
					<div class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-slate-700 mb-1">Meta Title (Judul SEO)</label>
							<input type="text" name="meta_title" value={berita.meta_title || ''} class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-emerald-500 outline-none" placeholder="Maksimal 60 karakter disarankan">
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-700 mb-1">Meta Deskripsi</label>
							<textarea name="meta_description" rows="2" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-emerald-500 outline-none" placeholder="Deskripsi singkat yang muncul di Google...">{berita.meta_description || ''}</textarea>
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-700 mb-1">Kata Kunci (Keywords)</label>
							<input type="text" name="meta_keywords" value={berita.meta_keywords || ''} placeholder="Contoh: kajian ahad, masjid bekasi, infaq" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-emerald-500 outline-none">
						</div>
					</div>
				</div>
				
				<div id="alert-container" class="hidden rounded-md p-4"></div>
				
				<div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
					<button type="button" onclick="window.location.href='/admin/berita'" class="px-5 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-500">Batal</button>
					<button type="submit" id="btn-submit" class="px-5 py-2 bg-emerald-600 text-white rounded-md hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">Simpan Perubahan</button>
				</div>
			</form>
		</div>
	</div>
</AdminLayout>

<script is:inline>
	document.getElementById('form-berita').addEventListener('submit', async (e) => {
		e.preventDefault();
		
		const form = e.target;
		const formData = new FormData(form);
		const btnSubmit = document.getElementById('btn-submit');
		const alertContainer = document.getElementById('alert-container');
		
		btnSubmit.disabled = true;
		btnSubmit.textContent = 'Menyimpan...';
		
		try {
			const res = await fetch('/api/berita', {
				method: 'POST',
				body: formData
			});
			
			const result = await res.json();
			
			if (result.success) {
				alertContainer.className = 'rounded-md p-4 bg-emerald-50 text-emerald-800';
				alertContainer.innerHTML = '<p class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg> Perubahan berhasil disimpan!</p>';
				alertContainer.classList.remove('hidden');
			} else {
				throw new Error(result.error || 'Terjadi kesalahan');
			}
		} catch (err) {
			alertContainer.className = 'rounded-md p-4 bg-red-50 text-red-800';
			alertContainer.innerHTML = `<p class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" /></svg> Gagal: ${err.message}</p>`;
			alertContainer.classList.remove('hidden');
		} finally {
			btnSubmit.disabled = false;
			btnSubmit.textContent = 'Simpan Perubahan';
		}
	});
</script>

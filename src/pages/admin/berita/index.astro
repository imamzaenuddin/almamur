---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { pool } from '../../../lib/db';

const [berita] = await pool.query(`
    SELECT b.id, b.judul, b.views, b.status, b.created_at, k.nama_kategori 
    FROM berita b 
    LEFT JOIN kategori k ON b.id_kategori = k.id 
    ORDER BY b.created_at DESC
`);
---
<AdminLayout title="Manajemen Berita & Konten">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-slate-800">Manajemen Berita & Konten</h1>
        <a href="/admin/berita/tambah" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-lg font-medium shadow-sm transition flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" /></svg>
            Tulis Berita
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-slate-700 border-b border-slate-200">
                <tr>
                    <th class="px-6 py-4 font-semibold">Judul Konten</th>
                    <th class="px-6 py-4 font-semibold">Kategori</th>
                    <th class="px-6 py-4 font-semibold">Tanggal</th>
                    <th class="px-6 py-4 font-semibold">Views</th>
                    <th class="px-6 py-4 font-semibold text-right">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {berita.map((item) => (
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-6 py-4 font-medium text-slate-800">
                            {item.judul}
                            {item.status === 'draft' && <span class="ml-2 px-2 py-0.5 bg-slate-100 text-slate-500 rounded text-xs">Draft</span>}
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-full text-[10px] font-bold uppercase tracking-wider border border-emerald-100">
                                {item.nama_kategori}
                            </span>
                        </td>
                        <td class="px-6 py-4">{new Date(item.created_at).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</td>
                        <td class="px-6 py-4 font-medium">{item.views}</td>
                        <td class="px-6 py-4 text-right space-x-2">
                            <a href={`/admin/berita/edit/${item.id}`} class="text-amber-500 hover:text-amber-700 font-medium px-3 py-1.5 bg-amber-50 hover:bg-amber-100 rounded-md transition text-xs">Edit</a>
                            <button onclick={`hapusBerita(${item.id})`} class="text-red-500 hover:text-red-700 font-medium px-3 py-1.5 bg-red-50 hover:bg-red-100 rounded-md transition text-xs">Hapus</button>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
        
        {berita.length === 0 && (
            <div class="text-center py-10 text-slate-500">
                Belum ada berita atau konten kajian yang diterbitkan.
            </div>
        )}
    </div>

    <script is:inline>
        async function hapusBerita(id) {
            if(confirm('Apakah Anda yakin ingin menghapus konten ini?')) {
                try {
                    const res = await fetch(`/api/berita?id=${id}`, { method: 'DELETE' });
                    if(res.ok) window.location.reload();
                    else alert('Gagal menghapus berita.');
                } catch(err) {
                    alert('Terjadi kesalahan koneksi.');
                }
            }
        }
    </script>
</AdminLayout>

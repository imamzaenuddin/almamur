---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { pool } from '../../../lib/db';

const [users] = await pool.query("SELECT id, nama, email, role FROM users ORDER BY id ASC");
---
<AdminLayout title="Manajemen User">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-slate-800">Manajemen Pengurus & Admin</h1>
        <button onclick="bukaModalTambah()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-medium shadow-sm transition">
            + Tambah User
        </button>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-slate-700 border-b border-slate-200">
                <tr>
                    <th class="px-6 py-4 font-semibold">Nama</th>
                    <th class="px-6 py-4 font-semibold">Email</th>
                    <th class="px-6 py-4 font-semibold">Role</th>
                    <th class="px-6 py-4 font-semibold text-right">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {users.map((u) => (
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-6 py-4 font-medium text-slate-800">{u.nama}</td>
                        <td class="px-6 py-4">{u.email}</td>
                        <td class="px-6 py-4">
                            <span class={`px-2 py-1 rounded-full text-[10px] font-bold uppercase ${u.role === 'admin' ? 'bg-amber-100 text-amber-700 border border-amber-200' : 'bg-blue-100 text-blue-700 border border-blue-200'}`}>
                                {u.role}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right space-x-2">
                            <button onclick={`editUser(${JSON.stringify(u)})`} class="text-amber-500 hover:text-amber-700 font-medium px-3 py-1 bg-amber-50 hover:bg-amber-100 rounded-md transition">Edit</button>
                            <button onclick={`hapusUser(${u.id})`} class="text-red-500 hover:text-red-700 font-medium px-3 py-1 bg-red-50 hover:bg-red-100 rounded-md transition">Hapus</button>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>

    <!-- Modal Tambah -->
    <div id="modalTambah" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center z-50">
        <div class="bg-white p-6 rounded-2xl shadow-xl w-full max-w-md border border-slate-100">
            <div class="flex justify-between items-center mb-5">
                <h2 id="modalTitle" class="text-xl font-bold text-slate-800">Tambah User Baru</h2>
                <button onclick="document.getElementById('modalTambah').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-2xl leading-none">&times;</button>
            </div>
            <form id="formTambahUser" class="space-y-4">
                <input type="hidden" name="id" id="formId">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap</label>
                    <input type="text" name="nama" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                    <input type="email" name="email" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Password <span id="pwdHint" class="text-xs text-slate-400 font-normal hidden">(Kosongkan jika tidak ingin diubah)</span></label>
                    <input type="password" id="inputPwd" name="password" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Role Akses</label>
                    <select name="role" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500 outline-none transition bg-white">
                        <option value="pengurus">Pengurus (Hanya kelola konten)</option>
                        <option value="admin">Admin (Kelola konten & sistem)</option>
                    </select>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-lg transition mt-6 shadow-md">Simpan User</button>
            </form>
        </div>
    </div>

    <script is:inline>
        function bukaModalTambah() {
            document.getElementById('modalTitle').innerText = 'Tambah User Baru';
            document.getElementById('formId').value = '';
            document.getElementById('formTambahUser').reset();
            document.getElementById('inputPwd').required = true;
            document.getElementById('pwdHint').classList.add('hidden');
            document.getElementById('modalTambah').classList.remove('hidden');
        }

        function editUser(u) {
            document.getElementById('modalTitle').innerText = 'Edit User';
            document.getElementById('formId').value = u.id;
            document.getElementById('formTambahUser').elements['nama'].value = u.nama;
            document.getElementById('formTambahUser').elements['email'].value = u.email;
            document.getElementById('formTambahUser').elements['role'].value = u.role;
            document.getElementById('inputPwd').required = false;
            document.getElementById('pwdHint').classList.remove('hidden');
            document.getElementById('modalTambah').classList.remove('hidden');
        }

        document.getElementById('formTambahUser').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            try {
                const res = await fetch('/api/users', { method: 'POST', body: formData });
                const data = await res.json();
                if(data.success) {
                    window.location.reload();
                } else {
                    alert('Gagal menambah user: ' + (data.error || ''));
                }
            } catch(err) {
                alert('Terjadi kesalahan koneksi.');
            }
        });

        async function hapusUser(id) {
            if(confirm('Apakah Anda yakin ingin menghapus user ini secara permanen?')) {
                try {
                    const res = await fetch(`/api/users?id=${id}`, { method: 'DELETE' });
                    if(res.ok) window.location.reload();
                    else alert('Gagal menghapus user.');
                } catch(err) {
                    alert('Terjadi kesalahan koneksi.');
                }
            }
        }
    </script>
</AdminLayout>

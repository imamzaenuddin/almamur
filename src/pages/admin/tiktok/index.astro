---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { pool } from '../../../lib/db';

const [tiktoks] = await pool.query("SELECT * FROM tiktok_videos ORDER BY created_at DESC");
---
<AdminLayout title="Manajemen TikTok">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Manajemen Slider TikTok</h1>
            <p class="text-slate-500 text-sm mt-1">Kelola konten video dakwah yang tampil di halaman depan.</p>
        </div>
        <button onclick="bukaModalTambah()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-lg font-medium shadow-md transition flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" /></svg>
            Tambah Video Baru
        </button>
    </div>

    {tiktoks.length === 0 ? (
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-12 text-center">
            <p class="text-slate-500">Belum ada video TikTok yang ditambahkan.</p>
        </div>
    ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {tiktoks.map(item => (
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden relative group">
                    <div class="h-48 relative overflow-hidden bg-slate-900">
                        <img src={item.thumbnail || '/images/placeholder.png'} alt={item.judul} class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="w-12 h-12 bg-black/40 backdrop-blur-sm rounded-full flex items-center justify-center border border-white/20">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-semibold text-slate-800 line-clamp-2 mb-2 text-sm">{item.judul}</h3>
                        <div class="flex items-center gap-4 text-xs font-medium text-slate-500 mb-4">
                            <span class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z" /><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg> {item.views || 0}</span>
                            <span class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-pink-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" /></svg> {item.likes || 0}</span>
                        </div>
                        <div class="flex justify-between border-t border-slate-100 pt-3">
                            <a href={item.url_video} target="_blank" class="text-xs text-blue-600 hover:underline">Buka Tautan</a>
                            <div class="space-x-3">
                                <button onclick={`editTiktok(${JSON.stringify(item)})`} class="text-xs text-amber-500 hover:text-amber-700 font-medium">Edit</button>
                                <button onclick={`hapusTiktok(${item.id})`} class="text-xs text-red-500 hover:text-red-700 font-medium">Hapus</button>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    )}

    <!-- Modal Tambah -->
    <div id="modalTambah" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center z-50 p-4">
        <div class="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-100 transform transition-all">
            <div class="flex justify-between items-center mb-5">
                <h2 id="modalTitle" class="text-xl font-bold text-slate-800">Tambah Video TikTok</h2>
                <button onclick="document.getElementById('modalTambah').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-2xl leading-none">&times;</button>
            </div>
            <form id="formTambahTiktok" class="space-y-4">
                <input type="hidden" name="id" id="formId">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Judul Singkat / Caption</label>
                    <input type="text" name="judul" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none" placeholder="Tausiyah singkat tentang...">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">URL Video TikTok</label>
                    <input type="url" name="url_video" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none" placeholder="https://www.tiktok.com/@...">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">URL Gambar Thumbnail (Opsional)</label>
                    <input type="url" name="thumbnail" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none" placeholder="Biarkan kosong untuk default">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Views (Contoh: 1.2K)</label>
                        <input type="text" name="views" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Likes (Contoh: 450)</label>
                        <input type="text" name="likes" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:ring-emerald-500 outline-none">
                    </div>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-lg transition mt-6 shadow-md">Simpan Video</button>
            </form>
        </div>
    </div>

    <script is:inline>
        function bukaModalTambah() {
            document.getElementById('modalTitle').innerText = 'Tambah Video TikTok';
            document.getElementById('formId').value = '';
            document.getElementById('formTambahTiktok').reset();
            document.getElementById('modalTambah').classList.remove('hidden');
        }

        function editTiktok(item) {
            document.getElementById('modalTitle').innerText = 'Edit Video TikTok';
            document.getElementById('formId').value = item.id;
            document.getElementById('formTambahTiktok').elements['judul'].value = item.judul;
            document.getElementById('formTambahTiktok').elements['url_video'].value = item.url_video;
            document.getElementById('formTambahTiktok').elements['thumbnail'].value = item.thumbnail || '';
            document.getElementById('formTambahTiktok').elements['views'].value = item.views || '';
            document.getElementById('formTambahTiktok').elements['likes'].value = item.likes || '';
            document.getElementById('modalTambah').classList.remove('hidden');
        }

        document.getElementById('formTambahTiktok').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            try {
                const res = await fetch('/api/tiktok', { method: 'POST', body: formData });
                const data = await res.json();
                if(data.success) window.location.reload();
                else alert('Gagal: ' + (data.error || ''));
            } catch(err) {
                alert('Terjadi kesalahan koneksi.');
            }
        });

        async function hapusTiktok(id) {
            if(confirm('Hapus video ini dari slider?')) {
                try {
                    const res = await fetch(`/api/tiktok?id=${id}`, { method: 'DELETE' });
                    if(res.ok) window.location.reload();
                    else alert('Gagal menghapus.');
                } catch(err) {
                    alert('Terjadi kesalahan koneksi.');
                }
            }
        }
    </script>
</AdminLayout>

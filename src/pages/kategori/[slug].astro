---
import Layout from '../../layouts/Layout.astro';
import { pool } from '../../lib/db';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect('/404');
}

// Ambil info kategori
const [kategoriRows] = await pool.query('SELECT * FROM kategori WHERE slug = ?', [slug]);
const kategori = kategoriRows[0];

if (!kategori) {
	return Astro.redirect('/404');
}

// Ambil berita berdasarkan kategori
const [berita] = await pool.query(
	`SELECT b.id, b.judul, b.slug, b.ringkasan, b.gambar_utama, b.created_at, b.views, u.nama as penulis 
	 FROM berita b 
	 JOIN users u ON b.id_penulis = u.id 
	 WHERE b.id_kategori = ? AND b.status = 'published' 
	 ORDER BY b.created_at DESC`,
	[kategori.id]
);
---

<Layout title={`Kategori: ${kategori.nama_kategori} - Masjid Al-Ma'mur`}>
	<div class="mb-12">
		<div class="bg-gradient-to-r from-emerald-700 to-teal-600 rounded-3xl p-10 md:p-16 text-white shadow-xl relative overflow-hidden">
			<div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -mr-20 -mt-20"></div>
			<div class="absolute bottom-0 left-0 w-64 h-64 bg-black/10 rounded-full blur-3xl -ml-20 -mb-20"></div>
			
			<div class="relative z-10 text-center max-w-2xl mx-auto">
				<span class="px-4 py-1.5 rounded-full bg-white/20 text-white font-semibold text-sm mb-6 inline-block backdrop-blur-md">
					Kategori Artikel
				</span>
				<h1 class="text-4xl md:text-5xl font-extrabold mb-4">{kategori.nama_kategori}</h1>
				<p class="text-emerald-100 text-lg md:text-xl">Kumpulan berita, informasi, dan artikel terkait {kategori.nama_kategori} di Masjid Al-Ma'mur.</p>
			</div>
		</div>
	</div>

	{berita.length === 0 ? (
		<div class="bg-white rounded-2xl p-16 text-center shadow-sm border border-slate-100">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-slate-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H14" />
			</svg>
			<p class="text-slate-500 text-lg">Belum ada konten untuk kategori ini.</p>
		</div>
	) : (
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{berita.map((item) => (
				<article class="bg-white rounded-2xl shadow-sm hover:shadow-xl border border-slate-100 overflow-hidden hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full">
					<div class="h-56 w-full overflow-hidden relative">
						<img src={item.gambar_utama || "/images/placeholder.png"} alt={item.judul} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						<div class="absolute top-4 left-4">
							<span class="bg-white/90 backdrop-blur-sm text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider shadow-sm">
								{kategori.nama_kategori}
							</span>
						</div>
					</div>
					<div class="p-6 flex flex-col flex-grow">
						<h3 class="text-xl font-bold mb-3 text-slate-900 line-clamp-2 leading-snug group-hover:text-emerald-600 transition-colors">
							<a href={`/berita/${item.slug}`}>
								{item.judul}
								<span class="absolute inset-0" aria-hidden="true"></span>
							</a>
						</h3>
						<p class="text-slate-600 text-sm mb-6 line-clamp-3 leading-relaxed flex-grow">{item.ringkasan}</p>
						<div class="flex justify-between items-center text-sm font-medium text-slate-500 pt-4 border-t border-slate-100 mt-auto">
							<div class="flex items-center gap-2">
								<div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">
									{item.penulis.charAt(0).toUpperCase()}
								</div>
								<span>{item.penulis}</span>
							</div>
							<span class="flex items-center gap-1">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
								</svg>
								{item.views}
							</span>
						</div>
					</div>
				</article>
			))}
		</div>
	)}
</Layout>

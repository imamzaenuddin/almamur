---
import '../styles/global.css';
import { getProfilMasjid } from '../lib/db';

const { title = "Portal Web", description, keywords } = Astro.props;
const profil = await getProfilMasjid();

const defaultMasjidName = "Masjid Al-Ma'mur";
const masjidName = profil?.nama_masjid || defaultMasjidName;
const displayTitle = title.includes(defaultMasjidName) ? title.replace(defaultMasjidName, masjidName) : `${title} - ${masjidName}`;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={profil?.logo_url || "/favicon.svg"} />
		<title>{displayTitle}</title>
		{description && <meta name="description" content={description} />}
		{keywords && <meta name="keywords" content={keywords} />}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<style>
			body {
				font-family: 'Plus Jakarta Sans', sans-serif;
			}
			.glass-nav {
				background: rgba(255, 255, 255, 0.85);
				backdrop-filter: blur(12px);
				border-bottom: 1px solid rgba(0,0,0,0.05);
			}
		</style>
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen selection:bg-emerald-500 selection:text-white">
		<header class="glass-nav fixed w-full top-0 z-50 transition-all duration-300">
			<div class="container mx-auto px-4 lg:px-8 py-4 flex justify-between items-center">
				<a href="/" class="flex items-center gap-3 group">
					{profil?.logo_url ? (
						<img src={profil.logo_url} alt="Logo Masjid" class="w-10 h-10 object-contain group-hover:scale-105 transition-transform duration-300" />
					) : (
						<div class="w-10 h-10 bg-emerald-600 text-white rounded-xl flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform duration-300">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
							</svg>
						</div>
					)}
					<span class="text-2xl font-extrabold tracking-tight text-slate-900 group-hover:text-emerald-600 transition-colors">{profil?.nama_masjid || "Al-Ma'mur"}</span>
				</a>
				
				<!-- Desktop Menu -->
				<nav class="hidden md:flex space-x-1 lg:space-x-2">
					<a href="/" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-full transition-all">Beranda</a>
					<a href="/profil" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-full transition-all">Profil</a>
					<a href="/kategori/kajian" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-full transition-all">Kajian</a>
					<a href="/kategori/kegiatan" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-full transition-all">Kegiatan</a>
					<a href="/galeri" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-full transition-all">Galeri</a>
				</nav>

				<div class="hidden md:flex items-center space-x-3">
					<a href="/admin/berita/tambah" class="px-5 py-2.5 text-sm font-bold text-emerald-700 bg-emerald-100 hover:bg-emerald-200 rounded-full transition-all shadow-sm">Admin Portal</a>
				</div>
				
				<!-- Mobile Menu Button (Hamburger) -->
				<button class="md:hidden text-slate-600 hover:text-emerald-600 focus:outline-none">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
		</header>
		
		<main class="flex-grow pt-24 pb-12">
			<slot />
		</main>

		<footer class="bg-slate-900 text-slate-300 pt-16 pb-8 border-t border-slate-800">
			<div class="container mx-auto px-4 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-12 mb-12">
					<div class="lg:col-span-2">
						<a href="/" class="flex items-center gap-3 mb-6">
							{profil?.logo_url ? (
								<img src={profil.logo_url} alt="Logo Masjid" class="w-10 h-10 object-contain" />
							) : (
								<div class="w-10 h-10 bg-emerald-600 text-white rounded-xl flex items-center justify-center shadow-lg">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
									</svg>
								</div>
							)}
							<span class="text-2xl font-bold tracking-tight text-white">{profil?.nama_masjid || "Masjid Al-Ma'mur"}</span>
						</a>
						<p class="text-slate-400 mb-6 max-w-sm leading-relaxed">
							Pusat informasi kegiatan, kajian Islami, dan layanan jamaah secara digital. Mewujudkan masjid yang makmur dan memakmurkan sekitarnya.
						</p>
						<div class="flex space-x-4">
							<a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-emerald-600 hover:text-white transition-colors">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
							</a>
							<a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-emerald-600 hover:text-white transition-colors">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
							</a>
							<a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-emerald-600 hover:text-white transition-colors">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
							</a>
						</div>
					</div>
					
					<div>
						<h4 class="text-white font-bold mb-6 uppercase tracking-wider text-sm">Tautan Cepat</h4>
						<ul class="space-y-3">
							<li><a href="/" class="hover:text-emerald-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Beranda</a></li>
							<li><a href="/kategori/kajian" class="hover:text-emerald-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Jadwal Kajian</a></li>
							<li><a href="/kategori/kegiatan" class="hover:text-emerald-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Kegiatan Masjid</a></li>
							<li><a href="/kategori/pengumuman" class="hover:text-emerald-400 transition-colors flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Pengumuman</a></li>
						</ul>
					</div>
					
					<div>
						<h4 class="text-white font-bold mb-6 uppercase tracking-wider text-sm">Kontak Kami</h4>
						<ul class="space-y-4">
							<li class="flex items-start gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
								</svg>
								<a href="https://www.google.com/maps?vet=10CAAQoqAOahcKEwiQiaehovCVAxUAAAAAHQAAAAAQCQ..i&pvq=CgwvZy8xcTVibDNqX3oiGwoVbWFzamlkIGphbWkgYWwgbWFrbXVyEAIYAw&lqi=ChVtYXNqaWQgamFtaSBhbCBtYWttdXJI_oeHqZWWgIAIWiUQABABEAIQAxgAGAEYAiIVbWFzamlkIGphbWkgYWwgbWFrbXVykgEGbW9zcXVlmgFEQ2k5RFFVbFJRVU52WkVOb2RIbGpSamx2VDJ4Q2FtRXdPV3BoTUU1NVYwYzFRbGt4WkZKaGJIQm9XREExVldGSFl4QUL6AQQIABAt&fvr=1&cs=1&um=1&ie=UTF-8&fb=1&gl=id&sa=X&ftid=0x2e698c60fb88ab8b:0x448c0d2578350f91" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">Jl. Bintara XIV, RT.002/RW.009, Bintara, Kec. Bekasi Bar., Kota Bks, Jawa Barat 17134</a>
							</li>
							<li class="flex items-center gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
								</svg>
								<span>info@masjidalmamur.id</span>
							</li>
							<li class="flex items-center gap-3">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
								</svg>
								<span>+62 812 3456 7890</span>
							</li>
						</ul>
					</div>
				</div>
				
				<div class="pt-8 border-t border-slate-800 text-center text-slate-500 text-sm flex flex-col md:flex-row justify-between items-center">
					<p>&copy; {new Date().getFullYear()} Masjid Al-Ma'mur. All rights reserved.</p>
					<div class="mt-4 md:mt-0 space-x-4">
						<a href="#" class="hover:text-white transition-colors">Kebijakan Privasi</a>
						<a href="#" class="hover:text-white transition-colors">Syarat & Ketentuan</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

